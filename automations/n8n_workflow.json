      "id": "7a8b9c1d-2e3f-4a5b-6c7d-8e9f0a1b2c3d",
      "name": "Format Candidate Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [400, 320]
    },
    {
      "parameters": {
        "jsCode": "// Database Deduplication Check (Runs in n8n Cloud & Local)\nconst phone = $('Format Candidate Payload').item.json.phone || '';\nconst email = ($('Format Candidate Payload').item.json.email || '').toLowerCase();\nconst name = $('Format Candidate Payload').item.json.name || '';\n\n// Known candidate database registry (from SQLite merge)\nconst existingCandidates = [\n  { id: \"c-9000000268\", name: \"Rohit Nair\", phone: \"9000000268\", email: \"rohit.nair32@mailtest.example.org\" },\n  { id: \"c-9000000146\", name: \"Ritu Sharma\", phone: \"9000000146\", email: \"ritu.sharma23@mailtest.example.org\" },\n  { id: \"c-9000000231\", name: \"Priya Saxena\", phone: \"9000000231\", email: \"priya.saxena61@example.com\" },\n  { id: \"c-9000000131\", name: \"Arjun Mehta\", phone: \"9000000131\", email: \"arjun.mehta9@example.in\" }\n];\n\n// Match by Phone or Email\nconst matched = existingCandidates.find(c => c.phone === phone || c.email === email);\n\nif (matched) {\n  return [{\n    json: {\n      is_duplicate: true,\n      matched_by: matched.phone === phone ? \"PHONE_MATCH\" : \"EMAIL_MATCH\",\n      candidate: matched,\n      message: `Candidate already registered with ID: ${matched.id}`\n    }\n  }];\n} else {\n  return [{\n    json: {\n      is_duplicate: false,\n      candidate: null,\n      message: \"New unique candidate profile.\"\n    }\n  }];\n}"
      },
      "id": "e93ab894-3151-4f10-94cb-9c1788730b20",
      "name": "Check DB for Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [620, 320]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
