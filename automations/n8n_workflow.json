      "id": "31b268b8-b4b6-455b-b9f1-a185b3b5550a",
      "name": "Send Duplicate Alert (Slack/Webhook)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1080, 220]
    },
    {
      "parameters": {
        "jsCode": "// AI Talent Skill Categorization Engine\nconst skills = ($('Format Candidate Payload').item.json.skills || '').toLowerCase();\nlet category = 'general-engineering';\nlet confidence = 0.90;\nlet reasoning = 'Categorized based on verified skill profile.';\n\nif (skills.includes('n8n') || skills.includes('zapier') || skills.includes('selenium') || skills.includes('scraping')) {\n  category = 'automation-heavy';\n  confidence = 0.96;\n  reasoning = 'Extensive experience with workflow tools and web scraping.';\n} else if (skills.includes('react') || skills.includes('javascript') || skills.includes('fastapi')) {\n  category = 'web-dev';\n  confidence = 0.94;\n  reasoning = 'Full-stack web application development stack.';\n} else if (skills.includes('sql') || skills.includes('pandas') || skills.includes('mongodb') || skills.includes('mysql')) {\n  category = 'data-engineering';\n  confidence = 0.92;\n  reasoning = 'Strong database querying and data wrangling capabilities.';\n} else if (skills.includes('langchain') || skills.includes('llm') || skills.includes('ai')) {\n  category = 'ai-ml';\n  confidence = 0.95;\n  reasoning = 'Generative AI and agentic workflow expertise.';\n}\n\nreturn [{\n  json: {\n    category: category,\n    confidence: confidence,\n    reasoning: reasoning,\n    auto_tag: {\n      category: category,\n      confidence: confidence\n    }\n  }\n}];"
      },
      "id": "e2a14917-8cfb-4a58-86d1-efd5bf22718e",
